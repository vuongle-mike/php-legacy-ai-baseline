<!doctype html><meta charset="utf-8"><title>Notes</title><h1>Notes</h1>
<a href="/?action=logout">Logout</a>
<form><input name="q" value="{{ q }}"><button>Search</button></form><p>Search: {{ q }}</p>
<ul>{% for note in notes %}<li><a href="/?action=note&id={{ note.id }}">{{ note.title }}</a> <a href="/?action=delete&id={{ note.id }}">Delete</a></li>{% endfor %}</ul>
<form method="post" action="/?action=create"><input name="title" placeholder="Title"><textarea name="body"></textarea><button>Create</button></form>
<a href="/?action=download&file=sample.txt">Download sample</a>
